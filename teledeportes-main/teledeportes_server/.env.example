NODE_ENV=development
PORT=4000
TZ=America/Bogota

# Compose project name (prefix for the DB container).
COMPOSE_PROJECT_NAME=app

# Database — values consumed by both the app and docker-compose.yml.
DB_USER=app
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=app

# pgAdmin (docker compose)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=admin

# Security (TSS 05)
JWT_SECRET_PRIMARY=
JWT_SECRET_PREVIOUS=
JWT_KID=primary
BCRYPT_COST=12
TOKEN_PEPPER=
TOKEN_PREFIX=project

# CORS allowlist (comma-separated). Required when cookie session is enabled.
ALLOWED_ORIGINS=

# Reverse proxy hops (TSS 05 [RIGID]). 1 = Nginx only, 2 = Cloudflare + Nginx.
TRUST_PROXY=1

# MASTER_ACCESS — dev only. Server crashes at boot if true with NODE_ENV=production.
MASTER_ACCESS=false
MASTER_ACCESS_KEY=

# Auth session
SESSION_TTL_HOURS=168

# Bootstrap webmaster (consumed by `npm run seed:users`).
# Leave empty in production unless you are bootstrapping a brand-new instance.
SEED_WEBMASTER_EMAIL=
SEED_WEBMASTER_NAME=Webmaster
SEED_WEBMASTER_PASSWORD=

# Redis (BullMQ transcode queue). Host = compose service name in-container.
REDIS_HOST=redis
REDIS_PORT=6379

# Media plane (VOD). MEDIA_ROOT is the shared volume mount inside the
# app + worker containers. MEDIA_PUBLIC_URL is where nginx serves the HLS.
MEDIA_ROOT=/media
MEDIA_PUBLIC_URL=http://localhost:8090
MEDIA_MAX_UPLOAD_MB=5120
MEDIA_MAX_IMAGE_MB=8
MEDIA_NGINX_PORT=8090

# HTTP request timeout in ms (whole request incl. streamed upload body). Node's
# default is 5 min, too short for heavy video uploads. 0 disables it.
REQUEST_TIMEOUT_MS=1800000

# Transcoder: how many videos process at once per worker.
TRANSCODE_CONCURRENCY=1

# OvenMediaEngine (live channels). Public host/ports the players + encoders use.
OME_PUBLIC_SCHEME=http
OME_PUBLIC_HOST=localhost
OME_WEBRTC_PORT=3333
OME_LLHLS_PORT=3333
OME_RTMP_PORT=1935
OME_SRT_PORT=9999
OME_INGEST_HOST=localhost
OME_APP=app
# Shared secret to verify OME's admission webhook (HMAC-SHA1).
OME_ADMISSION_SECRET=
