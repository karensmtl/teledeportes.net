# TSS vite/06 — every URL / per-env knob via VITE_* env var.
# Vite only exposes variables prefixed with VITE_ to the client bundle.

# Backend API (TSS vite/04). No trailing slash.
VITE_API_ENDPOINT=https://your-backend.example.com/api/v1

# CDN public assets (optional).
VITE_CDN_PUBLIC=

# Studio (WHIP) ingest base — OvenMediaEngine app endpoint. The web Studio
# publishes to `${VITE_STUDIO_ENDPOINT}/<streamKey>?direction=whip`.
# Dev: http://localhost:3333/app   ·   Prod: https://<ome-host>/app
VITE_STUDIO_ENDPOINT=http://localhost:3333/app

# Live playback base — OvenPlayer WebRTC signalling (WebSocket). The player uses
# `${VITE_LIVE_ENDPOINT}/<slug>` for WebRTC and the https-equivalent for LL-HLS.
# Dev: ws://localhost:3333/app   ·   Prod: wss://<ome-host>/app
VITE_LIVE_ENDPOINT=ws://localhost:3333/app

# Project metadata (rendered in the footer, used by sync_tss).
VITE_PROJECT_NAME=Trianametria App
